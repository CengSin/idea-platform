NEXT_PUBLIC_SITE_URL=https://idea-platform-delta.vercel.app

# vercel (default) uses private Blob / local JSON.
# turso stores rows in a Turso/libSQL database.
DATA_BACKEND=turso
TURSO_DATABASE_URL=libsql://idea-platform-xxxx.turso.io
TURSO_AUTH_TOKEN=

# Protects GET /api/v1/export.
DATA_EXPORT_TOKEN=

# Scheduled Idea Agent analysis and optional Resend email delivery.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
CRON_SECRET=
RESEND_API_KEY=
IDEA_AGENT_EMAIL_FROM="Idea Platform <ideas@example.com>"
IDEA_AGENT_MODEL=

# Existing registered accounts in this allowlist can open /admin.
ADMIN_EMAILS=admin@example.com
