NEXT_PUBLIC_SITE_URL=https://your-domain.example

# 本地默认写 data/showcase.json；生产必须是 turso（新表 showcase_store，不动旧表）。
DATA_BACKEND=turso
TURSO_DATABASE_URL=libsql://xxxx.turso.io
TURSO_AUTH_TOKEN=

# 后台登录密码（单人）。可选 SESSION_SECRET；不设时改密码会让所有会话失效。
ADMIN_PASSWORD=
SESSION_SECRET=

# GitHub：有 GITHUB_TOKEN（只读，含私有仓库）时可省略 GITHUB_USER；只设 GITHUB_USER 则只同步公开仓库。
GITHUB_TOKEN=
GITHUB_USER=

# 本地 npm run curate 写线上数据时用：线上地址（配合 ADMIN_PASSWORD）。
SHOWCASE_URL=

# Vercel Cron 每天调用 /api/cron/sync 时携带。
CRON_SECRET=
