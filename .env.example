NEXT_PUBLIC_SITE_URL=https://idea-platform-delta.vercel.app

# vercel (default) uses private Blob / local JSON.
# mysql talks to the Go API and stores rows in MySQL.
# turso stores rows in a Turso/libSQL database.
DATA_BACKEND=turso
TURSO_DATABASE_URL=libsql://idea-platform-xxxx.turso.io
TURSO_AUTH_TOKEN=
# DATA_BACKEND=mysql
# MYSQL_API_URL=http://127.0.0.1:8081

# Protects GET /api/v1/export on Next.js and Go admin import/export.
DATA_EXPORT_TOKEN=
